# ---- Required ---------------------------------------------------------------
# Server-side only. Never commit a real key or expose it to the frontend.
GEMINI_API_KEY=your-gemini-api-key
# Long random string, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET=change-me
# Bootstrap administrator created on first start
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123
# Used by docker-compose for PostgreSQL
POSTGRES_PASSWORD=change-me

# ---- Optional (defaults shown) -----------------------------------------------
# DOMAIN_PROFILE=nepal_citizenship      # or customer_service (store demo in sample_data/)
# QUERY_ANALYSIS=true                   # LLM language/intent/fact analysis per message (1 extra request)
# CLARIFYING_QUESTIONS=true
# DATABASE_URL=sqlite:///./data/app.db   # local dev; compose sets PostgreSQL
# LLM_PROVIDER=gemini                    # "fake" = offline deterministic provider for tests/demos
# GEMINI_MODEL=gemini-flash-lite-latest  # highest free-tier limits; run `python -m app.cli list-models` to see what your key supports
# GEMINI_FALLBACK_MODELS=gemini-flash-latest  # tried in order on 503/429/404; empty = off
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_DIMENSIONS=768
# CORS_ORIGINS=http://localhost:3000
# PUBLIC_API_URL=http://localhost:8000   # URL the browser uses to reach the backend
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=200
# TOP_K=5
# RELEVANCE_THRESHOLD=0.55
# MAX_CONTEXT_CHUNKS=4
# HISTORY_MESSAGES=8
# RATE_LIMIT_CHAT=20                     # requests per minute per user
# MAX_UPLOAD_MB=10
